# MIME types correctos para los assets de la app
AddType model/gltf-binary .glb
AddType application/manifest+json .webmanifest .json
AddType application/json .json
AddType image/svg+xml .svg

# Compresión del servidor (si está disponible)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# Caché inmutable para assets con hash en el nombre
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType model/gltf-binary "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresDefault "access plus 0 seconds"
</IfModule>

# El HTML siempre se revalida (no cache) para que las actualizaciones
# se vean al recargar; los assets con hash se cachean por 1 año.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpe?g|gif|svg|webp|glb|json|webmanifest)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
