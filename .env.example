# ========================================================
# SHOPIFY STOREFRONT API - EJEMPLO DE VARIABLES
# ========================================================

# Dominio myshopify de la tienda (ej: tu-tienda.myshopify.com)
VITE_SHOPIFY_STORE_DOMAIN="tambo-active.myshopify.com"

# Token público de la API Storefront (NUNCA uses la clave secreta Admin API en el frontend)
VITE_SHOPIFY_STOREFRONT_TOKEN="tu_storefront_access_token_aqui"
